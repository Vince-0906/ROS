<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Gazebo传感器插件宏定义 -->
    <xacro:macro name="gazebo_sensor_plugin">
        <!-- 激光雷达传感器配置 -->
        <gazebo reference="laser_link">
            <!-- GPU加速的激光雷达传感器 -->
            <sensor name="gpu_lidar" type="gpu_lidar">
                <!-- 发布话题名称 -->
                <topic>lidar</topic>
                <!-- 更新频率 10Hz -->
                <update_rate>10</update_rate>
                <lidar>
                    <!-- 设置扫描范围 -->
                    <scan>
                        <!-- 描述水平扫描范围 -->
                        <horizontal>
                            <!-- 每圈采样光束数量 -->
                            <samples>360</samples>
                            <!-- 分辨率，与samples一起决定实际采样点数量 -->
                            <resolution>1.000000</resolution>
                            <!-- 起始扫描角度 (弧度) -->
                            <min_angle>0.000000</min_angle>
                            <!-- 终止扫描角度 (弧度，约等于2π) -->
                            <max_angle>6.283100</max_angle>
                        </horizontal>
                    </scan>
                    <!-- 设置扫描距离 -->
                    <range>
                        <!-- 最小检测距离 (米) -->
                        <min>0.080000</min>
                        <!-- 最大检测距离 (米) -->
                        <max>10.0</max>
                        <!-- 距离分辨率 (米) -->
                        <resolution>0.010000</resolution>
                    </range>
                </lidar>
                <!-- 是否在Gazebo中可视化激光束 -->
                <visualize>true</visualize>
            </sensor>
        </gazebo>

        <!-- IMU惯性测量单元传感器配置 -->
        <gazebo reference="imu_link">
            <!-- IMU传感器定义 -->
            <sensor name="imu_sensor" type="imu">
                <!-- 发布话题名称 -->
                <topic>imu</topic>
                <!-- 更新频率 100Hz -->
                <update_rate>100</update_rate>
                <!-- 始终保持开启状态 -->
                <always_on>1</always_on>
                <!-- 是否在Gazebo中可视化 -->
                <visualize>true</visualize>
                <!-- 六轴噪声设置 -->
                <imu>
                    <!-- 角速度传感器噪声配置 (陀螺仪) -->
                    <angular_velocity>
                        <!-- X轴角速度噪声 -->
                        <x>
                            <!-- 高斯噪声模型 -->
                            <noise type="gaussian">
                                <!-- 噪声均值 -->
                                <mean>0.0</mean>
                                <!-- 噪声标准差 -->
                                <stddev>2e-4</stddev>
                                <!-- 偏差均值 -->
                                <bias_mean>0.0000075</bias_mean>
                                <!-- 偏差标准差 -->
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </x>
                        <!-- Y轴角速度噪声 -->
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </y>
                        <!-- Z轴角速度噪声 -->
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>2e-4</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <!-- 线性加速度传感器噪声配置 (加速度计) -->
                    <linear_acceleration>
                        <!-- X轴线性加速度噪声 -->
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </x>
                        <!-- Y轴线性加速度噪声 -->
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </y>
                        <!-- Z轴线性加速度噪声 -->
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>1.7e-2</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>
        <!-- RGB相机传感器配置 -->
        <gazebo reference="camera_link">
            <!-- RGB相机传感器定义 -->
            <sensor name="camera" type="camera">
                <!-- 传感器位姿 (x y z roll pitch yaw) -->
                <pose>0 0 0 0 0 0</pose>
                <!-- 发布话题名称 -->
                <topic>/camera</topic>
                <!-- 更新频率 25Hz -->
                <update_rate>25</update_rate>
                <!-- 是否启用性能指标统计 -->
                <enable_metrics>false</enable_metrics>
                <!-- 相机参数配置 -->
                <camera name="head">
                    <!-- 相机位姿 -->
                    <pose>0 0 0 0 0 0</pose>
                    <!-- 水平视场角 (弧度) -->
                    <horizontal_fov>1.3</horizontal_fov>
                    <!-- 图像参数 -->
                    <image>
                        <!-- 图像宽度 (像素) -->
                        <width>640</width>
                        <!-- 图像高度 (像素) -->
                        <height>480</height>
                        <!-- 图像格式 -->
                        <format>RGB_INT8</format>
                        <!-- 抗锯齿采样倍数 -->
                        <anti_aliasing>4</anti_aliasing>
                    </image>
                    <!-- 相机信息话题名称，使用默认值 -->
                    <camera_info_topic>__default__</camera_info_topic>
                    <!-- 触发话题，空表示不使用触发模式 -->
                    <trigger_topic></trigger_topic>
                    <!-- 是否使用触发模式 -->
                    <triggered>false</triggered>
                    <!-- 相机裁剪平面 -->
                    <clip>
                        <!-- 近裁剪平面距离 (米) -->
                        <near>0.02</near>
                        <!-- 远裁剪平面距离 (米) -->
                        <far>30</far>
                    </clip>
                    <!-- 可见性掩码，用于选择性渲染 -->
                    <visibility_mask>4294967295</visibility_mask>
                    <!-- 图像噪声模型 -->
                    <noise>
                        <!-- 噪声类型 -->
                        <type>gaussian</type>
                        <!-- 噪声均值 -->
                        <mean>0</mean>
                        <!-- 噪声标准差 -->
                        <stddev>0.0070000000000000001</stddev>
                    </noise>
                </camera>
            </sensor>
        </gazebo>

        <!-- 深度相机传感器配置 -->
        <gazebo reference="camera_link">
            <!-- 深度相机传感器定义 -->
            <sensor name="depth_camera" type="depth_camera">
                <!-- 传感器位姿 (x y z roll pitch yaw) -->
                <pose>0 0 0 0 0 0</pose>
                <!-- 发布话题名称 -->
                <topic>/depth_camera</topic>
                <!-- 更新频率 25Hz -->
                <update_rate>25</update_rate>
                <!-- 是否启用性能指标统计 -->
                <enable_metrics>false</enable_metrics>
                <!-- 深度相机参数配置 -->
                <camera name="depth">
                    <!-- 相机位姿 -->
                    <pose>0 0 0 0 0 0</pose>
                    <!-- 水平视场角 (弧度) -->
                    <horizontal_fov>1.3</horizontal_fov>
                    <!-- 图像参数 -->
                    <image>
                        <!-- 图像宽度 (像素) -->
                        <width>640</width>
                        <!-- 图像高度 (像素) -->
                        <height>480</height>
                        <!-- 深度图像格式 -->
                        <format>R_FLOAT32</format>
                    </image>
                    <!-- 相机信息话题名称，使用默认值 -->
                    <camera_info_topic>__default__</camera_info_topic>
                    <!-- 相机裁剪平面 -->
                    <clip>
                        <!-- 近裁剪平面距离 (米) -->
                        <near>0.1</near>
                        <!-- 远裁剪平面距离 (米) -->
                        <far>10.0</far>
                    </clip>
                    <!-- 深度图像噪声模型 -->
                    <noise>
                        <!-- 噪声类型 -->
                        <type>gaussian</type>
                        <!-- 噪声均值 -->
                        <mean>0.0</mean>
                        <!-- 噪声标准差 -->
                        <stddev>0.01</stddev>
                    </noise>
                </camera>
            </sensor>
        </gazebo>
   </xacro:macro>
</robot>
