<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find szcbot_description)/urdf/szcbot/common_inertia.xacro"/>


    <!-- 机器人的轮子部件 -->
        <xacro:macro name="caster_xacro" params="caster_name xyz">
        <link name="${caster_name}_link">
        <!-- 部件的外观描述 -->
        <visual>
        <!-- 沿着自己几何中心的偏移和旋转 -->
            <origin xyz="0.0 0.0 0.0" rpy=" 0.0 0.0 0.0"/>
            <!-- 几何形状 -->
            <geometry>
                <sphere radius="0.016"/>
            </geometry>
            <!-- 材质和颜色 -->
            <material name="yellow">
                <color rgba="1.0 1.0 0.0 0.85"/>
            </material>
        </visual>
        <collision>
        <!-- 沿着自己几何中心的偏移和旋转 -->
            <origin xyz="0.0 0.0 0.0" rpy=" 0.0 0.0 0.0"/>
            <!-- 几何形状 -->
            <geometry>
                <sphere radius="0.016"/>
            </geometry>
            <!-- 材质和颜色 -->
            <material name="yellow">
                <color rgba="1.0 1.0 0.0 0.85"/>
            </material>
        </collision>
        <xacro:sphere_inertia m="0.05" r="0.016" />
    </link>
        <!-- 机器人的关节，用于组合各个部件 -->
    <joint name="${caster_name}_joint" type="fixed">
        <!-- 关节的父部件 -->
        <parent link="base_link"/>
        <!-- 关节的子部件 -->
        <child link="${caster_name}_link"/>
        <!-- 关节的偏移和旋转 -->
        <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
    </joint>
                    <gazebo reference ="${caster_name}_link">
        <material>Gazebo/Yellow</material>
        <mu1 value="0.0"/>
        <mu2 value="0.0"/>
        <kp value="1000000000.0"/>
        <kd value="1.0"/>
    </gazebo>
    </xacro:macro>

</robot>