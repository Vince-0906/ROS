      </link>
    </model>

    <model name="short_wall_obstacle">
      <static>true</static>
      <pose>-0.5 -5 1.4 0 0 0.7</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 2.5 2.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 2.5 2.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.68 0.72 0.7 1</ambient>
            <diffuse>0.73 0.77 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
